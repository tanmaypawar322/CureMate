# PostgreSQL Database URL (Non-superuser application role with enforced RLS)
DATABASE_URL="postgresql://curemate_app:curemate_password@localhost:5432/curemate?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Backend Configuration
PORT=4000
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
